		"modmenu": [
			{
				"value": "pet.itpuppy.fluffyisles.integration.ModMenuIntegration",
				"adapter": "kotlin"
			}
		]
	},

	"mixins": [
		"fluffy-isles.mixins.json"
	],

	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}