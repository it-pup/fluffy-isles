{
	"schemaVersion": 1,
	"id": "fluffy-isles",
	"version": "${version}",
	"name": "${name}",
	"description": "${description}",

	"authors": [
		"itpuppy"
	],

	"contact": {
		"homepage": "https://itpuppy.pet/",
		"sources": "https://github.com/it-pup/fluffy-isles"
	},

	"license": "MIT",
	"icon": "assets/fluffy-isles/icon.png",
	"environment": "client",

	"entrypoints": {
		"main": [
			{
				"value": "pet.itpuppy.fluffyisles.FluffyIsles",
				"adapter": "kotlin"
			}
		],

		"modmenu": [
			{
				"value": "pet.itpuppy.fluffyisles.integration.ModMenuIntegration",
				"adapter": "kotlin"
			}
		]
	},

	"mixins": [
		"fluffy-isles.mixins.json"
	],

	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"cloth-config": ">=21.11.153",
		"java": ">=21",

		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},

	"suggests": {
		"modmenu": "*"
	},

	"accessWidener": "fluffy-isles.classtweaker"
}